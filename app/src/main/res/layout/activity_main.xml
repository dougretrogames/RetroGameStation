<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0A1A"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Branding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OneUI 9 / Android 17 Ready • Libretro &amp; Standalones"
                    android:textColor="#00F5D4"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tv_badge_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E1435"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="ARM64 • 16KB"
                android:textColor="#F72585"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- System Diagnostic Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161129"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNÓSTICO DO DISPOSITIVO &amp; NÚCLEOS"
                android:textColor="#7928CA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dispositivo: Detectando..."
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_native_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status NDK: Carregando bibliotecas nativas..."
                android:textColor="#4CC9F0"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_controller_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gamepad: Verificando periféricos físicos..."
                android:textColor="#FFB703"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_cores_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Núcleos Libretro: Carregando..."
                android:textColor="#00F5D4"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Action: Open ROM Browser -->
        <Button
            android:id="@+id/btn_open_rom"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#7928CA"
            android:text="📂  SELECIONAR E CARREGAR ROM (SAF)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Core Downloader Action Button -->
        <Button
            android:id="@+id/btn_manage_cores"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#00F5D4"
            android:text="📥  GERENCIADOR &amp; DOWNLOAD DE NÚCLEOS (BUILDBOT)"
            android:textColor="#0D0A1A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Grid of Emulator Engine Launchers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOTORES DE EMULAÇÃO NATIVOS &amp; STANDALONES"
            android:textColor="#A0A0A0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_launch_libretro"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1F1538"
                android:text="🎮 Libretro Host"
                android:textColor="#00F5D4"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_launch_ppsspp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#1F1538"
                android:text="🕹️ PSP Engine"
                android:textColor="#4CC9F0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_launch_mupen"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1F1538"
                android:text="🍄 N64 Engine"
                android:textColor="#F72585"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Secondary Controls: Settings & Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_test_controller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#18132B"
                android:text="🎮 Testar Gamepad"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_video_settings"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#18132B"
                android:text="📺 Configurar Vídeo"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Retro Game Station • Build 1.0.0 • Libretro Buildbot Core Downloader"
            android:textColor="#666666"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
